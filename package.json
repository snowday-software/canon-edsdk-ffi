{
    "name": "canon-edsdk-ffi",
    "version": "0.5.1",
    "description": "Modern TypeScript FFI wrapper for the Canon EOS Digital SDK (EDSDK), built with Koffi.",
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "clean": "rimraf dist",
        "build": "npm run clean && tsc -p tsconfig.json && esbuild dist/index.js --bundle --platform=node --format=cjs --outfile=dist/index.cjs --external:koffi",
        "prepare": "npm run build && husky",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --check .",
        "format:fix": "prettier --write .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:camera": "vitest run --config vitest.real-camera.config.ts",
        "test:ui-lock:interactive": "tsx test/real-camera/ui-lock.interactive.ts",
        "vendor:sync": "tsx scripts/vendor-sync.ts",
        "vendor:clean": "rimraf vendor/bin",
        "example:picture-test": "tsx examples/picture-test.ts"
    },
    "keywords": [
        "canon",
        "edsdk",
        "camera",
        "koffi",
        "ffi",
        "typescript"
    ],
    "engines": {
        "node": ">=18.0.0"
    },
    "dependencies": {
        "koffi": "3.0.2"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.0",
        "@types/node": "^24.13.0",
        "7zip-bin-full": "^26.3.1",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "prettier": "^3.9.6",
        "rimraf": "^6.0.1",
        "tsx": "^4.23.12",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.67.0",
        "vitest": "^4.1.10"
    },
    "allowScripts": {
        "koffi@3.0.2": true,
        "esbuild@0.28.2": true
    }
}
